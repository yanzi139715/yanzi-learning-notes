{
  "name": "yanzi-learning-notes",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.1.2",
  "scripts": {
    "dev": "next dev",
    "start": "next start",
    "build": "next build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/**/*.test.ts",
    "scan:sensitive": "./scripts/scan-sensitive.zsh",
    "verify": "pnpm scan:sensitive && ./tests/reject-sensitive-working-tree.zsh && pnpm test && pnpm typecheck && pnpm lint && pnpm build"
  },
  "dependencies": {
    "gray-matter": "4.0.3",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.12",
    "tsx": "4.23.1",
    "typescript": "6.0.3"
  }
}
